<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="4dp">
    <LinearLayout android:id="@+id/n_home" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:clickable="true" android:paddingTop="2dp" android:paddingBottom="2dp">
        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_circle_teal" android:padding="8dp" android:src="@drawable/ic_n_home"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Home" android:textSize="10sp" android:maxLines="1" android:textAppearance="@android:style/TextAppearance.Material.Notification"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/n_sale" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:clickable="true" android:paddingTop="2dp" android:paddingBottom="2dp">
        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_circle_teal" android:padding="8dp" android:src="@drawable/ic_n_cart"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Quick sale" android:textSize="10sp" android:maxLines="1" android:textAppearance="@android:style/TextAppearance.Material.Notification"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/n_exp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:clickable="true" android:paddingTop="2dp" android:paddingBottom="2dp">
        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_circle_orange" android:padding="8dp" android:src="@drawable/ic_n_wallet"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Expense" android:textSize="10sp" android:maxLines="1" android:textAppearance="@android:style/TextAppearance.Material.Notification"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/n_calc" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:clickable="true" android:paddingTop="2dp" android:paddingBottom="2dp">
        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_circle_teal" android:padding="8dp" android:src="@drawable/ic_n_calc"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Calculator" android:textSize="10sp" android:maxLines="1" android:textAppearance="@android:style/TextAppearance.Material.Notification"/>
    </LinearLayout>
</LinearLayout>
